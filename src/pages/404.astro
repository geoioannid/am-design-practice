---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Monogram from '../components/Monogram.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="not found — am design practice" noindex>
  <Nav />
  <main class="flex min-h-screen items-center justify-center px-4">
    <div class="flex flex-col items-center text-center">
      <Monogram class="h-20 w-auto" />
      <p class="label mt-10 text-muted-foreground">page not found</p>
      <a href={withBase('/')} class="label mt-6 underline underline-offset-8 hover:opacity-60">return home</a>
    </div>
  </main>
</BaseLayout>
