---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import FadeIn from '../../components/FadeIn.astro';
import Footer from '../../components/Footer.astro';
import ModelViewer from '../../components/ModelViewer.astro';
import { resolveUpload, isPortrait } from '../../lib/images';
import { chunkPairs, paragraphs } from '../../lib/blocks';
import { withBase } from '../../lib/url';
import { ORG_ID } from '../../lib/seo';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  const n = projects.length;
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: n > 1 ? projects[(i + 1) % n] : undefined },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const d = project.data;

const site = Astro.site ?? new URL('https://amdesignpractice.com');
const homeUrl = new URL(withBase('/'), site).href;
const pageUrl = new URL(withBase(`/projects/${project.id}/`), site).href;
const description =
  d.description ||
  `${d.title} — ${d.category.toLowerCase()} by am design practice${d.location ? `, ${d.location}` : ''}${d.year ? `, ${d.year}` : ''}.`;

// Same transform as the layout's og:image, so it is generated once.
const card = await getImage({
  src: resolveUpload(d.cover),
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
  quality: 80,
});
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: d.title,
    url: pageUrl,
    description,
    image: new URL(card.src, site).href,
    genre: d.category,
    inLanguage: 'en',
    creator: { '@id': `${homeUrl}${ORG_ID}` },
    ...(/^\d{4}$/.test(d.year) ? { dateCreated: d.year } : {}),
    ...(d.location ? { locationCreated: { '@type': 'Place', name: d.location } } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Projects', item: homeUrl },
      { '@type': 'ListItem', position: 2, name: d.title, item: pageUrl },
    ],
  },
];

// Glacier's "project details" list; empty fields are skipped.
const details = [
  ['category', d.category],
  ['location', d.location],
  ['year', d.year],
  ['client', d.client],
  ['status', d.status],
].filter((row): row is [string, string] => Boolean(row[1]));

// Resolve image metadata up front so the pair rule is decided at build time.
type SetImage = { image: string; img: ImageMetadata; caption?: string; portrait: boolean };
type RenderedBlock =
  | { kind: 'text'; title?: string; subtitle?: string; paragraphs: string[] }
  | { kind: 'images'; pairs: Array<[SetImage, SetImage] | [SetImage]> };

const renderedBlocks: RenderedBlock[] = d.blocks.map((block) =>
  block.type === 'text'
    ? { kind: 'text', title: block.title, subtitle: block.subtitle, paragraphs: paragraphs(block.text) }
    : {
        kind: 'images',
        pairs: chunkPairs(
          block.images.map((im) => {
            const img = resolveUpload(im.image);
            return { ...im, img, portrait: isPortrait(img) };
          }),
        ),
      },
);
---

<BaseLayout
  title={`${d.title} — am design practice`}
  description={description}
  image={d.cover}
  ogType="article"
  jsonLd={jsonLd}
>
  {d.model && <link slot="head" rel="preconnect" href="https://www.gstatic.com" crossorigin />}
  <Nav />
  <main class="pt-28 md:pt-36">
    <!-- Header: main image (or 3D model) left, title + details right -->
    <section class="mx-auto max-w-[1170px] px-4 sm:px-6 xl:px-0">
      <div class="grid gap-10 md:grid-cols-12 md:gap-x-10">
        <div class="md:col-span-7">
          {
            d.model ? (
              <ModelViewer
                model={d.model}
                poster={d.cover}
                alt={d.modelAlt || `3D model — ${d.title}`}
                orbit={d.modelOrbit}
              />
            ) : (
              <div class="bg-mist">
                <Picture
                  src={resolveUpload(d.cover)}
                  alt={d.title}
                  layout="constrained"
                  width={680}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  fetchpriority="high"
                  loading="eager"
                  decoding="sync"
                  class="block h-auto w-full"
                />
              </div>
            )
          }
        </div>

        <div class="md:col-span-5 md:pt-2">
          <h1 class="title-mono text-[22px] leading-snug text-balance md:text-[26px]">{d.title}</h1>

          {
            d.description && (
              <div class="mt-6 space-y-5">
                {paragraphs(d.description).map((para) => (
                  <p class="prose-body">{para}</p>
                ))}
              </div>
            )
          }

          {
            details.length > 0 && (
              <>
                <h2 class="title-mono mt-14 border-t border-border pt-8 text-[13px]">project details</h2>
                <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-5">
                  {details.map(([label, value]) => (
                    <div>
                      <dt class="label">{label}</dt>
                      <dd class="mt-1 text-[15px] text-muted-foreground">{value}</dd>
                    </div>
                  ))}
                </dl>
              </>
            )
          }
        </div>
      </div>
    </section>

    <!-- Body: ordered text sections and image sets -->
    {
      renderedBlocks.length > 0 && (
        <section class="mx-auto max-w-[1170px] space-y-16 px-4 pt-20 sm:px-6 md:space-y-24 md:pt-28 xl:px-0">
          {renderedBlocks.map((block) =>
            block.kind === 'text' ? (
              // Section label sits in its own column on the rule, like a drawing's title block.
              <FadeIn class="grid gap-y-5 border-t border-border pt-8 md:grid-cols-12 md:gap-x-10">
                <p class="label text-muted-foreground md:col-span-3">{block.subtitle}</p>
                <div class="max-w-[38rem] md:col-span-8 md:col-start-5">
                  {block.title && <h2 class="title-mono text-[17px] leading-snug text-balance md:text-[19px]">{block.title}</h2>}
                  <div class:list={['space-y-5', block.title && 'mt-6']}>
                    {block.paragraphs.map((para) => (
                      <p class="prose-body">{para}</p>
                    ))}
                  </div>
                </div>
              </FadeIn>
            ) : (
              <div class="space-y-[6px]">
                {block.pairs.map((pair) =>
                  pair.length === 2 && (pair[0].portrait || pair[1].portrait) ? (
                    // At least one portrait in the pair: side by side.
                    <FadeIn class="grid grid-cols-1 gap-[6px] sm:grid-cols-2">
                      {pair.map((im) => (
                        <figure>
                          <Picture
                            src={im.img}
                            alt={im.caption || d.title}
                            layout="constrained"
                            width={582}
                            formats={['avif', 'webp']}
                            fallbackFormat="webp"
                            class="block h-auto w-full bg-mist"
                          />
                          {im.caption && <figcaption class="label mt-3 mb-4 text-muted-foreground">{im.caption}</figcaption>}
                        </figure>
                      ))}
                    </FadeIn>
                  ) : (
                    // Landscape pair (or a single leftover image): full width, stacked.
                    pair.map((im) => (
                      <FadeIn>
                        <figure>
                          <Picture
                            src={im.img}
                            alt={im.caption || d.title}
                            layout="constrained"
                            width={1170}
                            formats={['avif', 'webp']}
                            fallbackFormat="webp"
                            class="block h-auto w-full bg-mist"
                          />
                          {im.caption && <figcaption class="label mt-3 mb-4 text-muted-foreground">{im.caption}</figcaption>}
                        </figure>
                      </FadeIn>
                    ))
                  ),
                )}
              </div>
            ),
          )}
        </section>
      )
    }

    <!-- Back to the index / next project (Glacier's solid button) -->
    <nav
      class="mx-auto flex max-w-[1170px] items-center justify-between gap-6 px-4 py-20 sm:px-6 md:py-28 xl:px-0"
      aria-label="Projects"
    >
      <a href={withBase('/#work')} class="label py-3 transition-opacity hover:opacity-60">← all projects</a>
      {
        next && (
          <a
            href={withBase(`/projects/${next.id}/`)}
            class="group flex flex-col items-end gap-2 bg-foreground px-6 py-4 text-white transition-opacity hover:opacity-90"
          >
            <span class="label">next project →</span>
            <span class="title-mono text-[13px] text-white/75">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </main>
  <Footer />
</BaseLayout>
