---
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '@fontsource/source-sans-3/300.css';
import '@fontsource/source-sans-3/400.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { resolveUpload } from '../lib/images';
import { withBase } from '../lib/url';
import { socialLinks } from '../lib/social';
import { metaDescription, profileUrls, ORG_ID } from '../lib/seo';
// Preloaded so the monospace wordmark/nav don't reflow when the webfont lands.
import monoFont from '@fontsource/space-mono/files/space-mono-latin-400-normal.woff2?url';
import sansFont from '@fontsource/source-sans-3/files/source-sans-3-latin-300-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** og:type — 'article' for project pages. */
  ogType?: 'website' | 'article' | 'profile';
  /** Page-specific JSON-LD, rendered after the site-wide Organization block. */
  jsonLd?: object | object[];
}

const {
  title,
  description = 'am design practice — architecture, interiors and bespoke furniture by Angeliki Mathiopoulou, designed in Greece.',
  image,
  noindex = false,
  ogType = 'website',
  jsonLd,
} = Astro.props;
const metaDesc = metaDescription(description);

const site = Astro.site ?? new URL('https://amdesignpractice.com');
const canonical = new URL(Astro.url.pathname, site);
// Social scrapers don't reliably fetch WebP/AVIF — no major platform documents
// either as og:image — so the share image is a dedicated JPEG card, center-
// cropped to 1200×630: Meta and LinkedIn want ~1.91:1, X's large card 2:1,
// WhatsApp needs ≥300px wide and under 600KB. Pages without a photo share the
// branded fallback card. getImage()'s URL already includes the base path.
const ogVariant = image
  ? await getImage({
      src: resolveUpload(image),
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpeg',
      quality: 80,
    })
  : undefined;
const ogImage = new URL(ogVariant?.src ?? withBase('/og-default.jpg'), site);
const ogWidth = ogVariant?.attributes.width ?? 1200;
const ogHeight = ogVariant?.attributes.height ?? 630;
const ogAlt = `${title} — featured photograph`;

const settings = (await getCollection('settings'))[0]?.data;
// Site-wide switch (CMS → Contact & footer → Allow search engines).
const blockSearch = noindex || !settings?.searchIndexing;
const home = new URL(withBase('/'), site).href;
const sameAs = profileUrls(socialLinks(settings));
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${home}${ORG_ID}`,
  name: 'am design practice',
  url: home,
  logo: new URL(withBase('/apple-touch-icon.png'), site).href,
  description:
    'Architecture, interiors and bespoke furniture by architectural designer Angeliki Mathiopoulou, designed and made in Greece.',
  founder: { '@type': 'Person', name: 'Angeliki Mathiopoulou', jobTitle: 'Architectural designer' },
  knowsAbout: ['Architecture', 'Interior design', 'Furniture design', 'Bespoke furniture'],
  ...(settings?.email ? { email: settings.email } : {}),
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'GR',
    ...(settings?.city && settings.city !== 'Greece' ? { addressLocality: settings.city } : {}),
  },
  ...(sameAs.length ? { sameAs } : {}),
};
const extraLd = jsonLd === undefined ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1f2650" />
    <title>{title}</title>
    <meta name="description" content={metaDesc} />
    <meta name="author" content="Angeliki Mathiopoulou" />
    {blockSearch && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="am design practice" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={ogWidth} />
    <meta property="og:image:height" content={ogHeight} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {extraLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <slot />

    <noscript>
      <style>
        [data-fade] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-fade]');
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('fade-in-up-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      els.forEach((el) => {
        const delay = Number(el.dataset.fadeDelay ?? 0);
        if (delay) el.style.transitionDelay = `${delay}ms`;
        io.observe(el);
      });
    </script>

    {
      beacon && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beacon })}
        />
      )
    }
  </body>
</html>
