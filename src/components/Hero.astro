---
import { Picture } from 'astro:assets';
import { resolveUpload } from '../lib/images';

interface Props {
  image: string;
  title: string;
  subtitle?: string;
}
const { image, title, subtitle } = Astro.props;
---

<!-- Fixed 630px, as in Glacier (its .parallax height at every breakpoint). -->
<section class="relative h-[630px] overflow-hidden bg-foreground" data-hero>
  <!-- Taller than the frame so the parallax shift never reveals an edge. -->
  <div class="absolute inset-x-0 -top-[15%] h-[130%] will-change-transform" data-parallax>
    <Picture
      src={resolveUpload(image)}
      alt=""
      layout="full-width"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      fetchpriority="high"
      loading="eager"
      decoding="sync"
      class="h-full w-full object-cover"
    />
  </div>
  <div class="absolute inset-0 bg-[#141834]/45"></div>

  <div class="relative flex h-full flex-col items-center justify-center px-4 text-center text-white">
    <h1 class="title-mono text-[22px] tracking-[0.4em] sm:text-3xl md:text-[40px]" style="margin-right:-0.4em">
      {title}
    </h1>
    {subtitle && <p class="label mt-6 text-white/90 md:mt-8">{subtitle}</p>}
  </div>

  <a
    href="#work"
    class="absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-3 text-white/80 transition-opacity hover:opacity-60"
    aria-label="Scroll to projects"
  >
    <span class="block h-12 w-px bg-current"></span>
  </a>
</section>

<script>
  // Background drifts at 30% of scroll speed while the hero is on screen.
  const layer = document.querySelector<HTMLElement>('[data-parallax]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (layer && hero && !still.matches) {
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      if (y <= hero.offsetHeight) layer.style.transform = `translate3d(0, ${y * 0.3}px, 0)`;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>
