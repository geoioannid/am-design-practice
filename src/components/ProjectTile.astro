---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { resolveUpload } from '../lib/images';
import { withBase } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const p = project.data;
---

<li class:list={['tile', p.featured && 'sm:col-span-2 sm:row-span-2']} data-category={p.category}>
  <a href={withBase(`/projects/${project.id}/`)} class="group relative block focus-visible:outline-offset-2">
    <div class="relative aspect-[4/5] overflow-hidden bg-mist">
      <!-- Decorative here: the caption below names the link; the project page carries the descriptive alt. -->
      <Picture
        src={resolveUpload(p.cover)}
        alt=""
        widths={p.featured ? [600, 900, 1200, 1600] : [400, 600, 800]}
        sizes={p.featured
          ? '(min-width: 1170px) 780px, (min-width: 640px) 100vw, 100vw'
          : '(min-width: 1170px) 386px, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading={index < 3 ? 'eager' : 'lazy'}
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.03]"
      />
    </div>
    <div class="tile-meta">
      <h2 class="title-mono text-[13px] md:text-[15px]">{p.title}</h2>
      <p class="label text-muted-foreground">{p.category}</p>
    </div>
  </a>
</li>
